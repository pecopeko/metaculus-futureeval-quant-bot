# =============================================================================
# Metaculus FutureEval Quant Bot — Environment Variables
# Copy to `.env` locally (never commit `.env`!) or set in GitHub Actions Secrets.
# =============================================================================

# --- REQUIRED FOR LIVE METACULUS READ/SUBMIT ---------------------------------
# Metaculus requires authentication for all /api/ endpoints as of 2026.
# Generate your bot token at: https://www.metaculus.com/futureeval/participate/
METACULUS_TOKEN=

# --- TARGET TOURNAMENT -------------------------------------------------------
# 33121 = Fall 2026 FutureEval ($50,000 pool, 2026-09-28 -> 2027-01-06)
# minibench = Bi-weekly $1,000 MiniBench
# bot-testing-area = Official test sandbox tournament
METACULUS_TOURNAMENT=33121

# --- OPTIONAL LLM PROVIDERS (bot runs $0 statistical+market fallback if unset)
# Claim free Metaculus-sponsored OpenRouter credits via:
# https://forms.gle/aQdYMq9Pisrf1v7d8
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Optional model override (default depends on detected provider)
# FORECAST_MODEL=anthropic/claude-sonnet-4.5

# --- SAFETY / CALIBRATION CONTROLS -------------------------------------------
# Set to "true" ONLY when ready to submit live forecasts + private reasoning comments
SUBMIT_FORECASTS=false
# Neyman/Baron extremizing exponent (empirically tuned on 2026 OOS backtest)
EXTREMIZE_D=1.08
# Maximum probability clipping floor/ceiling for log-score tail protection
PROB_MIN=0.01
PROB_MAX=0.99
